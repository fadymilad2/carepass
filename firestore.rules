rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid
        && !exists(/databases/$(database)/documents/account_deletions/$(uid));
    }
    function admin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admin_users/$(request.auth.uid))
        && get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.isActive == true;
    }
    function text(data, key, limit) {
      return !(key in data) || (data[key] is string && data[key].size() <= limit);
    }
    function validProfile(data) {
      return text(data, 'username', 100) && text(data, 'email', 254)
        && text(data, 'phoneNumber', 30) && text(data, 'city', 100)
        && text(data, 'selectedArea', 100) && text(data, 'dateOfBirth', 40)
        && text(data, 'emergencyContact', 100) && text(data, 'bloodType', 20)
        && text(data, 'fcmToken', 4096) && text(data, 'updatedAt', 40)
        && text(data, 'createdAt', 40)
        && (!('isNewUser' in data) || data.isNewUser is bool)
        && (!('termsAccepted' in data) || data.termsAccepted is bool)
        && (!('familyMembers' in data) || (data.familyMembers is list && data.familyMembers.size() <= 20));
    }
    function initialProfile() {
      return validProfile(request.resource.data)
        && request.resource.data.keys().hasOnly([
          'username', 'email', 'phoneNumber', 'city', 'selectedArea', 'dateOfBirth',
          'emergencyContact', 'bloodType', 'fcmToken', 'createdAt', 'updatedAt',
          'isNewUser', 'termsAccepted', 'familyMembers', 'subscriptionStatus',
          'planName', 'memberId', 'cardExpiryDate', 'subscriptionType',
          'bpChecksUsedThisMonth', 'sugarChecksUsedThisMonth', 'checksResetMonth'])
        && request.resource.data.get('subscriptionStatus', 'none') == 'none'
        && request.resource.data.get('planName', '') == ''
        && request.resource.data.get('memberId', '') == ''
        && request.resource.data.get('cardExpiryDate', '') == ''
        && request.resource.data.get('subscriptionType', 'individual') == 'individual'
        && request.resource.data.get('bpChecksUsedThisMonth', 0) == 0
        && request.resource.data.get('sugarChecksUsedThisMonth', 0) == 0
        && request.resource.data.get('checksResetMonth', '') == '';
    }
    match /users/{userId} {
      allow read: if owner(userId) || admin();
      allow create: if owner(userId) && initialProfile();
      allow update: if owner(userId) && resource.data.keys().hasOnly(['fcmToken']) && initialProfile();
      allow update: if owner(userId) && validProfile(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'username', 'email', 'phoneNumber', 'city', 'selectedArea', 'dateOfBirth',
          'emergencyContact', 'bloodType', 'fcmToken', 'createdAt', 'updatedAt',
          'isNewUser', 'termsAccepted', 'familyMembers']);
      match /payments/{id} {
        allow read: if owner(userId) || admin();
      }
      match /favorites/{providerId} {
        allow read, delete: if owner(userId);
        allow create, update: if owner(userId)
          && request.resource.data.keys().hasOnly(['providerId'])
          && request.resource.data.providerId == providerId
          && exists(/databases/$(database)/documents/providers/$(providerId));
      }
      match /notifications/{id} {
        allow read, delete: if owner(userId) || admin();
        allow update: if owner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
          && request.resource.data.isRead is bool;
      }
    }
    match /admin_users/{uid} {
      allow read: if owner(uid) || admin();
    }
    match /{collection}/{id} {
      allow read: if collection in ['providers', 'services', 'home_banners', 'subscription_plans'];
      allow read: if collection == 'discount_codes' && request.auth != null;
      allow read: if collection == 'settings' && id in ['app_config', 'app_content'];
      allow read: if admin();
      allow write: if admin() && collection in [
        'providers', 'services', 'home_banners', 'subscription_plans', 'discount_codes', 'settings'];
    }
  }
}
